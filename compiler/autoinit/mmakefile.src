#
#   Generate the libautoinit.a
#

include $(SRCDIR)/config/aros.cfg

#
# The D() macros in these files are compiled out, and the usual way to turn
# them on is to edit the source.  That cannot be reproduced from a build
# command, so they are also gated on a make variable:
#
#   gmake linklibs-autoinit AUTOINIT_DEBUG=1
#
# These functions are the PROGRAM_ENTRIES chain a loaded program walks between
# its entry point and its main().  On a target where no program has run before
# that stretch is silent, and a hang in it looks like the program never
# started at all.
#
ifeq ($(AUTOINIT_DEBUG),1)
USER_CPPFLAGS += -DDEBUG=1
endif


# list of automatically linked libs - included by the gcc spec file.
AUTOFILE := \
	auto

# libraries_nolibs must come BEFORE libraries
LIBHANDLINGFILES := \
	functions \
	dso_handle \
	libraries_nolibs \
	libraries

STARTUPFILES := \
	__showerror \
	commandline \
	commandname \
	__stdiowin \
	_programname \
        stdiowin \
        fromwb \
        initexitsets \
        startupvars \
        programentries

MISCFILES := \
	detach

FILES := $(LIBBASEFILES) $(LIBHANDLINGFILES) $(STARTUPFILES) $(MISCFILES)

#MM- core-linklibs : linklibs-autoinit
#MM- linklibs: linklibs-autoinit
#MM- linklibs-autoinit-includes : sdk-includes-$(AROS_TOOLCHAIN_RELEASE) \
#MM     compiler-stdc-includes kernel-aros-includes kernel-dos-includes \
#MM     kernel-exec-includes kernel-expansion-includes \
#MM     kernel-intuition-includes workbench-libs-workbench-includes
#MM linklibs-autoinit : linklibs-autoinit-includes linklibs-autoinit-autofile
#MM linklibs-autoinit32 : linklibs-autoinit-includes linklibs-autoinit-autofile

%copy_includes includes="autoinit.h detach.h" path=aros

%copy_files_q mmake=linklibs-autoinit-autofile files=$(AUTOFILE) dst=$(AROS_LIB)

%build_linklib mmake=linklibs-autoinit libname=autoinit files=$(FILES)

ifneq ($(AROS_TARGET_CPU32),)
%build_linklib mmake=linklibs-autoinit32 libname=autoinit files=$(FILES) libdir="$(AROS_LIB32)" objdir="$(GENDIR)/$(CURDIR)/32bit" cflags="$(strip $(TARGET_ISA_32_CFLAGS) $(TARGET_CFLAGS))"
endif
%common
