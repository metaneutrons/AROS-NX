#
# Generate the mui.lib library (normally called libmui.a).

include $(SRCDIR)/config/aros.cfg

FILES := \
    mui_allocaslrequesttags \
    mui_aslrequesttags \
    mui_makeobject \
    mui_newobject

#MM- linklibs : linklibs-mui
#MM- core-linklibs : linklibs-mui
# The compiler release needs these MUI headers, not the global Ports closure.
# Classic selector 0 retains the complete upstream includes prerequisite.
#MM linklibs-mui : sdk-includes-$(AROS_TOOLCHAIN_RELEASE) \
#MM    workbench-libs-muimaster-includes includes-libraries-mui

%build_linklib mmake=linklibs-mui libname=mui files=$(FILES)
	
%common
