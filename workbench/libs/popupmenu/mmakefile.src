
include $(SRCDIR)/config/aros.cfg

# For m68k --with-paranoia
NOWARN_FLAGS := $(NOWARN_FRAME_ADDRESS)
USER_CFLAGS := $(NOWARN_FLAGS)
USER_CPPFLAGS := -D__UTILITY_STDLIBBASE__
USER_LDFLAGS := -static

FILES :=  pm \
	  pmgraph \
	  pminit \
	  pminput \
	  window \
	  pmimages \
	  pmfind \
	  pmshadow \
	  pmtopography \
	  pmdlist \
	  pmlayout \
	  pmdrawshadow \
	  pmtags \
	  pmcreate \
	  pmmem \
	  pmprefs \
	  iff

# One client archive owner combines the hand-written varargs wrappers and
# their version-10 initializer with the generated API stubs/getlibbase.
# popupmenu.conf disables only the redundant generated client initializer.
LINKLIBFILES := staticlib/autoinit \
    staticlib/pm_exlst \
    staticlib/pm_filterimsg \
    staticlib/pm_getitemattrs \
    staticlib/pm_insertmenuitem \
    staticlib/pm_layoutmenu \
    staticlib/pm_makeitem \
    staticlib/pm_makemenu \
    staticlib/pm_openpopupmenu \
    staticlib/pm_setitemattrs

#MM workbench-libs-popupmenu-includes : \
#MM     kernel-exec-includes \
#MM     kernel-dos-includes \
#MM     kernel-graphics-includes \
#MM     kernel-utility-includes \
#MM     kernel-intuition-includes \
#MM     workbench-libs-cgfx-includes \
#MM     kernel-layers-includes \
#MM     workbench-libs-locale-includes \
#MM     workbench-libs-iffparse-includes \
#MM     workbench-libs-diskfont-includes \
#MM     workbench-libs-gadtools-includes \
#MM     includes-copy

#MM workbench-libs-popupmenu : \
#MM     linklibs

%build_module mmake=workbench-libs-popupmenu \
    modname=popupmenu modtype=library \
    files="$(FILES)" linklibname=popupmenu-shared \
    linklibfiles="$(LINKLIBFILES)"

%common
