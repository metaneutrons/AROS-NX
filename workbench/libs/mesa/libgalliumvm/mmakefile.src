# Target-side Gallivm for the reviewed Mesa 26 MCJIT configuration.
# LLVM libraries here must run on AROS; the host cross compiler is not a
# substitute for workbench-libs-llvm or its generated public headers.

include $(SRCDIR)/config/aros.cfg

CUR_MESADIR := src/gallium/auxiliary/gallivm
include $(SRCDIR)/$(CURDIR)/../mesa.cfg
include $(SRCDIR)/$(CURDIR)/gallivm-26.0.0.sources

ifeq ($(OPT_LLVM),)
ifneq ($(TARGET_LLVM_VER),)
OPT_LLVM := $(TARGET_LLVM_VER)
else
OPT_LLVM := 11.0.0
endif
endif
LLVM_VERSION_MAJOR := $(word 1,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_MINOR := $(word 2,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_HEX := 0x$(shell printf "%02x%02x" $(LLVM_VERSION_MAJOR) $(LLVM_VERSION_MINOR))

# ORCJIT has a different inventory and requires LLVM 15 or newer.
ifneq ($(OPT_MESAGL),26.0.0)
$(error Gallivm requires the reviewed Mesa 26.0.0 source inventory)
endif

#MM mesa3d-linklib-galliumvm : workbench-libs-llvm mesa3d-linklib-compiler-generated mesa3d-linklib-mesa-generated mesa3d-linklib-mesautil-generated

USER_INCLUDES += \
            -I$(SRCDIR)/compiler/crt/posixc/include/aros/posixc \
            -iquote $(top_srcdir)/src/gallium/include \
            -iquote $(top_srcdir)/src/gallium/auxiliary \
            -iquote $(top_srcdir)/src/compiler/nir \
            -I$(top_builddir)/src \
            -I$(top_builddir)/src/compiler \
            -iquote $(top_builddir)/src/compiler/nir \
            -I$(AROS_INCLUDES)

USER_CPPFLAGS += -DDRAW_LLVM_AVAILABLE=1 -DLLVM_AVAILABLE \
                 -DHAVE_LLVM=$(LLVM_VERSION_HEX) \
                 -DMESA_LLVM_VERSION_STRING=\"$(OPT_LLVM)\" \
                 -DGALLIVM_USE_ORCJIT=0 -DLLVM_IS_SHARED=0 -D__AROS__
USER_CFLAGS += $(MESA_NOWARNFLAGS)
USER_CXXFLAGS += $(MESA_NOWARNFLAGS)

GALLIVM_SOURCES_C := $(addprefix $(top_srcdir)/$(CUR_MESADIR)/,$(MESA26_GALLIVM_C_SOURCES:.c=))
GALLIVM_SOURCES_CXX := $(addprefix $(top_srcdir)/$(CUR_MESADIR)/,$(MESA26_GALLIVM_CXX_SOURCES:.cpp=))

%build_linklib mmake=mesa3d-linklib-galliumvm libname=galliumvm \
    libdir=$(top_libdir) objdir=$(top_builddir)/$(CUR_MESADIR) \
    files="$(GALLIVM_SOURCES_C)" cxxfiles="$(GALLIVM_SOURCES_CXX)"

%common
