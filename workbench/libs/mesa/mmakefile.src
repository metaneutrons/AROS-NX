#
#   Generate mesa3dgl.library
#

include $(SRCDIR)/config/aros.cfg

include $(SRCDIR)/$(CURDIR)/mesa.cfg
-include $(GENDIR)/$(CURDIR)/mesa3dgl/mesa3dgllibrary.entrypoints

#
# common mesa3d fetch...
#

#MM- ports-includes : mesa3d-includes-copy
#MM mesa3d-includes-copy : mesa3d-fetch

%fetch mmake=mesa3d-fetch archive=$(ARCHBASE) destination=$(PORTSDIR)/mesa \
    location=$(PORTSSOURCEDIR) archive_origins=$(REPOSITORIES) \
    suffixes="$(MESA_ARCHIVE_SUFFIXES)" checksums="$(MESA_ARCHIVE_CHECKSUMS)" \
    patches_specs=$(PATCHSPEC)

# Mesa 20.0.8's NIR and format generators require Mako. Keep its pure-Python
# runtime private to the generator process rather than depending on host site
# packages; both source distributions are content-pinned by the transpiler.
%fetch mmake=mesa3d-mako-fetch archive=mako-1.3.10 \
    destination=$(PORTSDIR)/mesa-python location=$(PORTSSOURCEDIR) \
    archive_origins=https://files.pythonhosted.org/packages/9e/38/bd5b78a920a64d708fe6bc8e0a2c075e1389d53bef8413725c63ba041535 \
    suffixes="tar.gz"

%fetch mmake=mesa3d-markupsafe-fetch archive=markupsafe-3.0.2 \
    destination=$(PORTSDIR)/mesa-python location=$(PORTSSOURCEDIR) \
    archive_origins=https://files.pythonhosted.org/packages/b2/97/5d42485e71dfc078108a86d6de8fa46db44a1a9295e89c5d6d4a06e23a62 \
    suffixes="tar.gz"

# Mesa 26 format generators import yaml. Keep the pure-Python package
# content-pinned and local to those generators on every host.
%fetch mmake=mesa3d-pyyaml-fetch archive=pyyaml-6.0.3 \
    destination=$(PORTSDIR)/mesa-python location=$(PORTSSOURCEDIR) \
    archive_origins=https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2 \
    suffixes="tar.gz" \
    checksums="pyyaml-6.0.3.tar.gz=sha256:d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"

%create_patch mmake=mesa3d-create-patch \
    archive=$(ARCHBASE) suffixes="tar.xz tar.gz" \
    destination=$(PORTSDIR)/mesa

#
# Real Mesa3DGL.library rules...
#

#MM- workbench-libs-complete : mesa3dgl-library-$(AROS_TARGET_TOOLCHAIN)
#MM- mesa3dgl-library-yes : mesa3dgl-library
#MM- workbench-libs-mesa : mesa3dgl-library

#MM mesa3dgl-library : includes workbench-libs-dxtn-includes linklibs-galliumauxiliary workbench-libs-gallium-linklib mesa3dgl-linklibs mesa3dgl-library-env

# Per-arch gallium core linklibs, mirroring MESA3DGL_GALLIUMCORE in
# mesa.cfg. Declare each one's build-order dependency so mmake builds the
# linklib before mesa3dgl-library consumes it.
#MM- mesa3dgl-library : mesa3dgl-galliumcore-$(AROS_TARGET_ARCH)
#MM- mesa3dgl-galliumcore-raspi : linklibs-galliumcoreapi

SHARED_LIB_SOURCES = \
            emul_arosc \
            tls

# raspi: the vc4 pipe driver lives in vc4gallium.hidd (runtime-bound via
# the GalliumCoreAPI table in MESA3DGL_GALLIUMCORE). aros_drm_shim.c stays
# here for its libc side — the fprintf/stderr intercepts and the per-task
# StdCBase resolver that st/mesa and the compiler core need — and for the
# gallium_core_get_api link anchor. Its drm/posix shims are inert in this
# module (aros_drm_bridge stays NULL); the hidd compiles its own copy.
# Gated on arch AND cpu: AROS_TARGET_ARCH is "raspi" for the aarch64
# target too, where the vc4 hidd (and with it the core table this file
# anchors) is not built. Excluded elsewhere so libc symbols stay
# untouched.
ifeq ($(AROS_TARGET_ARCH),raspi)
SHARED_LIB_SOURCES += aros_drm_shim
# Bridge ABI header (shared with the hidd), needed by aros_drm_shim.c.
USER_INCLUDES += -I$(SRCDIR)/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium
# hardware/bcm2708.h: the SoC gate on the render-scale feature (HVS5 has
# no scaled plane, so the Pi 4 must not divide the drawable).
USER_INCLUDES += -I$(SRCDIR)/arch/arm-native/soc/broadcom/2708/include
# The GalliumCoreAPI table linklib exists (galliumcoreapi in
# MESA3DGL_GALLIUMCORE) — let the sources take a real reference to it.
USER_CPPFLAGS += -DMESA3DGL_HAVE_COREAPI
endif

MESA3DGL_SOURCES = \
            mesa3dgl_support \
            mesa3dgl_gallium \
            mesa3dgl_init \
            mesa3dgl_getopenglstatetrackerapi \
            mesa3dgl_glacreatecontext \
            mesa3dgl_gladestroycontext \
            mesa3dgl_glagetconfig \
            mesa3dgl_glagetcurrentcontext \
            mesa3dgl_glagetprocaddress \
            mesa3dgl_glamakecurrent \
            mesa3dgl_glasetrast \
            mesa3dgl_glaswapbuffers

USER_INCLUDES += \
            -I$(top_srcdir)/src/mesa \
            -iquote $(top_builddir)/src \
            -iquote $(top_builddir)/src/mesa \
            -iquote $(top_builddir)/src/mesa/main \
            -iquote $(top_builddir)/src/mapi \
            -iquote $(top_builddir)/src/compiler/glsl \
            -iquote $(top_srcdir)/src/mesa/main \
            -iquote $(top_srcdir)/src/mapi \
            -iquote $(top_srcdir)/src/compiler/glsl \
            -iquote $(top_srcdir)/src/compiler/glsl/glcpp \
            -iquote $(top_srcdir)/src/talloc \
            -iquote $(top_srcdir)/src/gallium/include \
            -iquote $(top_srcdir)/src/gallium/auxiliary

MESAGL_LIBRARY_SOURCES_C := \
            $(SHARED_LIB_SOURCES) \
            $(MESA3DGL_SOURCES)

# The generated module makefile forces a global `-include` of
# `mesa3dgl$(MESAGLBUILD)_deflibdefs.h`. Make the dependency explicit to
# avoid parallel build races where compilation starts before headers exist.
$(OBJDIR)/$(MESAGLVERSION)/%.o: \
            $(OBJDIR)/$(MESAGLVERSION)/include/mesa3dgl$(MESAGLBUILD)_libdefs.h \
            $(OBJDIR)/$(MESAGLVERSION)/include/mesa3dgl$(MESAGLBUILD)_deflibdefs.h

ifneq ($(mesa3dgl_ENTRYPOINTS),)
MESA_COMPILEOPTIONS += $(CFLAGS_FUNCTION_SECTIONS)
#USER_LDFLAGS := -Wl,--gc-sections $(mesa3dgl_ENTRYPOINTS)
endif

USER_LDFLAGS += $(TARGET_CXX_LDFLAGS) -L$(top_libdir)

#USER_CPPFLAGS += -DDEBUG=1

%build_module_library mmake=mesa3dgl-library \
  modname="mesa3dgl$(MESAGLBUILD)" modtype=library \
  conffile="$(SRCDIR)/workbench/libs/gl/gl.conf" \
  confoverride="$(SRCDIR)/$(CURDIR)/mesa3dgl.conf" \
  objdir="$(OBJDIR)/$(MESAGLVERSION)" \
  files="$(MESAGL_LIBRARY_SOURCES_C)" \
  alwayscxxlink=yes \
  uselibs="glapi mesa mesa-sse41 compiler galliumauxiliary gallium mesautil pthread $(MESA3DGL_GALLIUMCORE)"

$(AROS_ENVARC)/SYS:
	%mkdir_q dir=$@

# Rewritten on every build: as a file target it would survive an
# OPT_MESAGL change, and gl.library would keep opening the old
# mesa3dgl against freshly built drivers.
#MM
mesa3dgl-library-env : | $(AROS_ENVARC)/SYS
	@$(ECHO) "mesa3dgl$(MESAGLBUILD)" > $(AROS_ENVARC)/SYS/GL.default

#
# mesa3d includes...
#

GL_INCLUDE_FILES := gl.h glext.h

%copy_includes mmake=mesa3d-includes-copy path=GL dir=$(top_srcdir)/include/GL includes=$(GL_INCLUDE_FILES)

KHR_INCLUDE_FILES := khrplatform.h

%copy_includes mmake=mesa3d-includes-copy path=KHR dir=$(top_srcdir)/include/KHR includes=$(KHR_INCLUDE_FILES)

GL_INCLUDE_FILES := egl.h eglext.h eglplatform.h eglmesaext.h
ifneq ($(wildcard $(top_srcdir)/include/EGL/eglextchromium.h),)
GL_INCLUDE_FILES += eglextchromium.h
endif

%copy_includes mmake=mesa3d-includes-copy path=EGL dir=$(top_srcdir)/include/EGL includes=$(GL_INCLUDE_FILES)

VK_INCLUDE_FILES := vulkan.h vulkan_core.h vk_icd.h vk_platform.h

%copy_includes mmake=mesa3d-includes-copy path=vulkan dir=$(top_srcdir)/include/vulkan includes=$(VK_INCLUDE_FILES)

# vulkan_core.h pulls these in unconditionally.
VK_VIDEO_INCLUDE_FILES := \
    vulkan_video_codecs_common.h \
    vulkan_video_codec_h264std.h \
    vulkan_video_codec_h264std_decode.h \
    vulkan_video_codec_h264std_encode.h \
    vulkan_video_codec_h265std.h \
    vulkan_video_codec_h265std_decode.h \
    vulkan_video_codec_h265std_encode.h \
    vulkan_video_codec_av1std.h \
    vulkan_video_codec_av1std_decode.h \
    vulkan_video_codec_av1std_encode.h \
    vulkan_video_codec_vp9std.h \
    vulkan_video_codec_vp9std_decode.h

%copy_includes mmake=mesa3d-includes-copy path=vk_video dir=$(top_srcdir)/include/vk_video includes=$(VK_VIDEO_INCLUDE_FILES)

%common
