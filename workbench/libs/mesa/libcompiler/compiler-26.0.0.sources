MESA26_COMPILER_SPIRV_C_SOURCES := \
	spirv/gl_spirv.c \
	spirv/spirv_to_nir.c \
	spirv/vtn_alu.c \
	spirv/vtn_amd.c \
	spirv/vtn_cfg.c \
	spirv/vtn_cmat.c \
	spirv/vtn_debug.c \
	spirv/vtn_glsl450.c \
	spirv/vtn_opencl.c \
	spirv/vtn_structured_cfg.c \
	spirv/vtn_subgroup.c \
	spirv/vtn_variables.c

MESA26_COMPILER_GLCPP_C_SOURCES := \
	glsl/glcpp/pp.c

MESA26_COMPILER_CORE_C_SOURCES := \
	glsl_types.c \
	shader_enums.c

MESA26_COMPILER_STATIC_C_SOURCES := \
	$(MESA26_COMPILER_GLSL_C_SOURCES) \
	$(MESA26_COMPILER_NIR_C_SOURCES) \
	$(MESA26_COMPILER_SPIRV_C_SOURCES) \
	$(MESA26_COMPILER_GLCPP_C_SOURCES) \
	$(MESA26_COMPILER_CORE_C_SOURCES)

MESA26_COMPILER_STATIC_CXX_SOURCES := \
	$(MESA26_COMPILER_GLSL_CXX_SOURCES)

# Generated outputs follow the separate generator groups in the recipe.
MESA26_COMPILER_GLSL_GENERATED_C_SOURCES := \
	builtin_types_data.c

MESA26_COMPILER_GLSL_GENERATED_CXX_SOURCES := \
	glsl/glsl_lexer.cpp \
	glsl/glsl_parser.cpp

MESA26_COMPILER_GLSL_GENERATED_ALWAYS_HEADERS := \
	builtin_types.h \
	glsl/glsl_parser.h \
	glsl/ir_expression_operation.h \
	glsl/ir_expression_operation_constant.h \
	glsl/ir_expression_operation_strings.h \
	glsl/float64_glsl.h

# The current recipe adds these five only when the corresponding Mesa 26 GLSL
# input exists. All five inputs exist in the pinned Mesa 26.0.0 source tree.
MESA26_COMPILER_GLSL_GENERATED_OPTIONAL_HEADERS := \
	glsl/cross_platform_settings_piece_all.h \
	glsl/bc1_glsl.h \
	glsl/bc4_glsl.h \
	glsl/etc2_rgba_stitch_glsl.h \
	glsl/astc_glsl.h

MESA26_COMPILER_GLSL_GENERATED_HEADERS := \
	$(MESA26_COMPILER_GLSL_GENERATED_ALWAYS_HEADERS) \
	$(MESA26_COMPILER_GLSL_GENERATED_OPTIONAL_HEADERS)

MESA26_COMPILER_NIR_GENERATED_C_SOURCES := \
	nir/nir_constant_expressions.c \
	nir/nir_intrinsics.c \
	nir/nir_opcodes.c \
	nir/nir_opt_algebraic.c

MESA26_COMPILER_NIR_GENERATED_HEADERS := \
	nir/nir_builder_opcodes.h \
	nir/nir_intrinsics.h \
	nir/nir_intrinsics_indices.h \
	nir/nir_opcodes.h

MESA26_COMPILER_SPIRV_GENERATED_C_SOURCES := \
	spirv/spirv_info.c \
	spirv/vtn_gather_types.c

MESA26_COMPILER_SPIRV_GENERATED_HEADERS := \
	spirv/spirv_info.h \
	spirv/vtn_generator_ids.h

MESA26_COMPILER_GLCPP_GENERATED_C_SOURCES := \
	glsl/glcpp/glcpp-lex.c \
	glsl/glcpp/glcpp-parse.c

MESA26_COMPILER_GLCPP_GENERATED_HEADERS := \
	glsl/glcpp/glcpp-parse.h

MESA26_COMPILER_GENERATED_C_SOURCES := \
	$(MESA26_COMPILER_GLSL_GENERATED_C_SOURCES) \
	$(MESA26_COMPILER_NIR_GENERATED_C_SOURCES) \
	$(MESA26_COMPILER_SPIRV_GENERATED_C_SOURCES) \
	$(MESA26_COMPILER_GLCPP_GENERATED_C_SOURCES)

MESA26_COMPILER_GENERATED_CXX_SOURCES := \
	$(MESA26_COMPILER_GLSL_GENERATED_CXX_SOURCES)

MESA26_COMPILER_GENERATED_HEADERS := \
	$(MESA26_COMPILER_GLSL_GENERATED_HEADERS) \
	$(MESA26_COMPILER_NIR_GENERATED_HEADERS) \
	$(MESA26_COMPILER_SPIRV_GENERATED_HEADERS) \
	$(MESA26_COMPILER_GLCPP_GENERATED_HEADERS)

# The current AROS recipe emits builtin_types_data.c from builtin_types_c.py.
# Upstream Mesa 26 names the equivalent Meson output builtin_types.c; keep this
# explicit delta visible before replacing the recipe.
