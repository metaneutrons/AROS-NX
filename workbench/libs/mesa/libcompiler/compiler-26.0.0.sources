# Mesa 26.0.0 compiler inventory for the AROS new-layout recipe.
# Paths are relative to src/compiler. Lists preserve the wildcard group order
# in workbench/libs/mesa/libcompiler/mmakefile.src.
#
# Standalone GLSL/glcpp entry points and scaffolding are deliberately absent:
# glsl/main.cpp, glsl/standalone.cpp, glsl/standalone_scaffolding.cpp,
# glsl/glcpp/glcpp.c and glsl/glcpp/pp_standalone_scaffolding.c.

MESA26_COMPILER_GLSL_C_SOURCES := \
	glsl/gl_nir_detect_function_recursion.c \
	glsl/gl_nir_link_atomics.c \
	glsl/gl_nir_link_functions.c \
	glsl/gl_nir_link_interface_blocks.c \
	glsl/gl_nir_link_uniform_blocks.c \
