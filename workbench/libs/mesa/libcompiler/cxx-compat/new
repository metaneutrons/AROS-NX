#ifndef AROS_MESA20_CXX_COMPAT_NEW
#define AROS_MESA20_CXX_COMPAT_NEW

/*
 * Mesa 20.0.8's selected GLSL compiler sources use only the standard
 * placement-new declarations.  AROS does not ship a target C++ standard
 * library header set, so keep this private compatibility header deliberately
 * smaller than <new>: it never allocates and provides no STL/runtime API.
 */
#include <stddef.h>

#if !defined(__cplusplus) || __cplusplus != 201402L
#error "Mesa 20.0.8 placement new requires the audited C++14 dialect"
#endif

inline void *operator new(size_t, void *storage) noexcept
{
    return storage;
}

inline void *operator new[](size_t, void *storage) noexcept
{
    return storage;
}

inline void operator delete(void *, void *) noexcept
{
}

inline void operator delete[](void *, void *) noexcept
{
}

#endif
