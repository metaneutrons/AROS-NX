# Mesa 26.0.0 libmesautil inventory for the AROS new-layout recipe.
# Mesa paths are relative to src/util. Static C preserves the recipe's
# wildcard order (util/*.c, then util/format/*.c), followed by its explicit
# additions; the listed filters have already been applied.
#
# Generated products remain separate from immutable fetched sources. The
# repository-owned replacements are listed in their own lane below.

MESA26_UTIL_STATIC_C_SOURCES := \
	anon_file.c \
	bitscan.c \
	blob.c \
	build_id.c \
	cache_ops_null.c \
	cnd_monotonic.c \
	compress.c \
	crc32.c \
	dag.c \
	disk_cache.c \
	disk_cache_os.c \
	double.c \
	fast_idiv_by_const.c \
	float8.c \
	fossilize_db.c \
	futex.c \
	half_float.c \
	hash_table.c \
	helpers.c \
	log.c \
	lut.c \
	mesa-blake3.c \
	mesa-sha1.c \
	mesa_cache_db.c \
	mesa_cache_db_multipart.c \
	os_file.c \
	os_file_notify.c \
	os_misc.c \
	os_socket.c \
	os_time.c \
	pb_slab.c \
	ralloc.c \
	rand_xor.c \
	range_minimum_query.c \
	rb_tree.c \
	register_allocate.c \
	rgtc.c \
	rwlock.c \
	set.c \
	simple_mtx.c \
	slab.c \
	softfloat.c \
	sparse_array.c \
	string_buffer.c \
	strndup.c \
	strtod.c \
	thread_sched.c \
	u_atomic.c \
	u_call_once.c \
	u_cpu_detect.c \
	u_debug.c \
	u_debug_memory.c \
	u_debug_stack.c \
	u_debug_symbol.c \
	u_dynarray.c \
	u_hash_table.c \
	u_idalloc.c \
	u_math.c \
	u_mm.c \
	u_printf.c \
	u_process.c \
	u_queue.c \
	u_range_remap.c \
	u_string.c \
	u_thread.c \
	u_vector.c \
	u_worklist.c \
	vl_zscan_data.c \
	vma.c \
	format/u_format.c \
	format/u_format_bptc.c \
	format/u_format_etc.c \
	format/u_format_fxt1.c \
	format/u_format_latc.c \
	format/u_format_other.c \
	format/u_format_rgtc.c \
	format/u_format_s3tc.c \
	format/u_format_tests.c \
	format/u_format_unpack_neon.c \
	format/u_format_yuv.c \
	format/u_format_zs.c \
	perf/u_trace.c \
	blake3/blake3.c \
	blake3/blake3_dispatch.c \
	blake3/blake3_portable.c

# Kept separate so every manifest path remains root-relative without `..`.
MESA26_UTIL_C11_C_SOURCES := \
	c11/impl/time.c \
	c11/impl/threads_posix.c

MESA26_UTIL_STATIC_CXX_SOURCES := \
	texcompress_astc.cpp \
	texcompress_astc_luts.cpp \
	texcompress_astc_luts_wrap.cpp \
	u_qsort.cpp

# Generated by the explicit Python rules in libmesautil/mmakefile.src.
MESA26_UTIL_GENERATED_C_SOURCES := \
	format/u_format_table.c \
	format_srgb.c

MESA26_UTIL_GENERATED_HEADERS := \
	format/u_format_gen.h \
	format/u_format_pack.h

# Added only when CPU=aarch64; this follows the upstream BLAKE3 NEON gate.
MESA26_UTIL_ARM64_C_SOURCES := \
	blake3/blake3_neon.c

# Repository-owned AROS fallbacks, not part of the fetched Mesa inventory.
# These paths are relative to the AROS repository root.
MESA26_UTIL_AROS_FALLBACK_C_SOURCES := \
	workbench/libs/mesa/libmesautil/mesa_memstream_aros.c \
	workbench/libs/mesa/libmesautil/mesa_u_dl_aros.c \
	workbench/libs/mesa/mesa_posix_compat_aros.c \
	workbench/libs/mesa/mesa_streaming_load_memcpy_fallback.c
