# Built with the LLVM profile alongside the draw-LLVM archive.
MESA26_GALLIUMAUX_TESS_CXX_SOURCES := \
	tessellator/p_tessellator.cpp \
	tessellator/tessellator.cpp

MESA26_GALLIUMAUX_GENERATED_C_SOURCES := \
	driver_trace/tr_util.c \
	util/u_tracepoints.c \
	indices/u_indices_gen.c \
	indices/u_unfilled_gen.c

MESA26_GALLIUMAUX_GENERATED_HEADERS := \
	driver_trace/tr_util.h \
	util/u_tracepoints.h

# The base archive excludes the LLVM draw trio and nir/nir_to_tgsi_info.c;
# the latter is present only in MESA26_GALLIUMAUX_DRAW_LLVM_C_SOURCES.
# The two vl/ entries are the explicit AROS additions, not the full upstream
# files_libgalliumvl archive. The upstream renderonly/ sources and remaining
# files_libgalliumvl sources are intentionally absent because the current AROS
# recipe has no corresponding source rule; they must be revisited if a DRM/VL
# profile is enabled.
