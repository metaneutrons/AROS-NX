ZLIBVERSION=1.3.1
ARCHBASE     := zlib
ZLIB_CHROMIUM_REVISION := da752eb2a3660cf1bf8dac620f6380b89dd953a7
ZLIB_PORT_ROOT := $(PORTSDIR)/zlib/chromium-$(ZLIB_CHROMIUM_REVISION)
ARCHSRCDIR := $(ZLIB_PORT_ROOT)

LIBZ_CPPFLAGS := -D_XOPEN_SOURCE=600 -DSTDC -DAMIGA
USER_INCLUDES += -idirafter $(ARCHSRCDIR)
