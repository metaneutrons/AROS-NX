#

include $(SRCDIR)/config/aros.cfg

FILES := \
    add		\
    code		\
    decode	\
    long_term     \
    lpc		\
    preprocess	\
    rpe		\
    gsm_destroy	\
    gsm_decode	\
    gsm_encode	\
    gsm_create	\
    gsm_option    \
    short_term    \
    table

#MM linklibs-gsm : includes
#MM includes-copy

# This private link library exports no SDK headers. Make previously expanded
# the unset INCLUDE_FILES to empty; state that list explicitly for all builders.
%copy_includes includes=""

USER_CFLAGS := -DHAVE_UNISTD_H

%build_linklib mmake=linklibs-gsm libname=gsm files=$(FILES)

%common
