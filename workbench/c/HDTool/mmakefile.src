#
#   Makefile to make HDTool

include $(SRCDIR)/config/aros.cfg

FILES := \
	main \
	deviceio \
	install \
	list \
	setup

EXEDIR := $(AROS_C)

#MM workbench-c : includes linklibs workbench-c-hdtool

%build_prog mmake=workbench-c-hdtool \
    progname=HDTool targetdir=$(EXEDIR) \
    files=$(FILES)

%common
