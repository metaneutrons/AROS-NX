#
#   Makefile to make HDTool

include $(SRCDIR)/config/aros.cfg

FILES := \
	main \
	deviceio \
	install \
	list \
	setup

EXEDIR := $(AROS_C)

#MM- workbench-c : workbench-c-hdtool
#MM workbench-c-hdtool : includes linklibs

%build_prog mmake=workbench-c-hdtool \
    progname=HDTool targetdir=$(EXEDIR) \
    files=$(FILES)

%common
