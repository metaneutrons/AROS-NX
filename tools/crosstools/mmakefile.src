# Producer-only linklib closure. Unlike toolchain-linklibs it deliberately
# does not include the generic CPU linklib aggregate, which can pull optional
# Ports through core-linklibs. The LLVM release variants below build their
# compiler runtime and C++ SDK against only these explicitly required core
# linklibs; linklibs-atomic remains part of the public LLVM toolchain ABI.
#MM- toolchain-linklibs-release :                               \
#MM    linklibs-atomic                                          \
#MM    toolchain-linklibs-$(AROS_TOOLCHAIN)-release-$(AROS_TARGET_CPU) \
#MM    toolchain-linklibs-$(AROS_TOOLCHAIN)-release

# Minimal temporary SDK required to link compiler-rt, libc++, libc++abi, and
# libunwind. Header generation remains transitive through each linklib.
#MM- tools-crosstools-runtime-linklibs :                        \
#MM    linklibs-startup                                         \
#MM    linklibs-exec                                            \
#MM    linklibs-arossupport                                     \
#MM    linklibs-amiga                                           \
#MM    linklibs-autoinit

