    {"source": "config/target.cfg.in", "configured_path": "$(TOP)/bin/$(AROS_TARGET_ARCH)-$(AROS_TARGET_CPU)/gen/config/target.cfg", "text": "FAMILY :=\nFLAVOUR := standalone\nAROS_TARGET_TOOLCHAIN := yes\nAROS_TOOLCHAIN := gnu\nTARGET_LLVM_RUNTIMES_STYLE := separate\nAROS_TARGET_BOOTLOADER :=\nTARGET_USELOGRES := no\nTARGET_UNITTESTS := no\nPCI_HIDD_TARGET :=\nOBJC_TARGET := no-objc\nJPEGXL_TOOLCHAINSUPPORT :=\nTARGET_LIBATOMIC := yes\nAROS_TARGET_PLATFORM := esp32p4-riscv\nARCH := $(AROS_TARGET_ARCH)\nCPU := $(AROS_TARGET_CPU)\n"}
  ],
  "declared_absent": [
    "DEBUG", "EBFPACKEDEXES", "LLVM_CMAKE_FILES", "MESA3DGL_GALLIUMCORE",
    "OPT_HOST_ALSA", "OPT_HOST_ANDROIDGFX", "OPT_HOST_PULSEAUDIO",
    "OPT_HOST_SDLGFX", "OPT_HOST_X11GFX", "OPT_HOST_X11_HOSTGL"
  ],
  "evidence_sources": [
