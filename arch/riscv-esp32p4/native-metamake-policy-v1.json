  "host_environment": [
    {"host": "linux-x86_64", "bindings": [{"name": "AROS_HOST_ARCH", "value": "linux"}, {"name": "AROS_HOST_CPU", "value": "x86_64"}]},
    {"host": "linux-aarch64", "bindings": [{"name": "AROS_HOST_ARCH", "value": "linux"}, {"name": "AROS_HOST_CPU", "value": "aarch64"}]},
    {"host": "macos-aarch64", "bindings": [{"name": "AROS_HOST_ARCH", "value": "darwin"}, {"name": "AROS_HOST_CPU", "value": "aarch64"}]}
