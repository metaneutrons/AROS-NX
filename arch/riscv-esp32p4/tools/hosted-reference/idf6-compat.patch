 #define MAX_PAYLOAD_SIZE (MAX_TRANSPORT_BUFFER_SIZE-H_ESP_PAYLOAD_HEADER_OFFSET)
 
@@ -102,6 +104,22 @@
 #define MALLOC(x)                        malloc(x)
 
 /* This is [malloc + aligned DMA] */
+#if ESP_IDF_VERSION_MAJOR >= 6
+#if CONFIG_SPIRAM
+#error "Reference allocator has only been audited with PSRAM disabled"
+#endif
+static inline void *hosted_reference_dma_alloc(size_t size)
+{
+    /* Retain historical 64-byte size/address alignment; the IDF6 heap adjusts
+     * DMA alignment for hardware/cache requirements. Explicitly restrict this
+     * reference to internal byte-accessible DMA memory; reject overflow. */
+    if (!size || size > SIZE_MAX - 63)
+        return NULL;
+    return heap_caps_aligned_alloc(64, (size + 63) & ~(size_t)63,
+        MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+}
+#define MEM_ALLOC(x) hosted_reference_dma_alloc(x)
+#else
 #define MEM_ALLOC(x)       ({                                       \
 	esp_dma_mem_info_t dma_mem_info = {                             \
 		.extra_heap_caps = 0,                                       \
@@ -113,6 +131,7 @@
 	err = esp_dma_capable_malloc((x), &dma_mem_info, &tmp_buf, &actual_size);\
 	if (err) tmp_buf = NULL;                                        \
 	tmp_buf;})
+#endif
 
 #define FREE(x)                          free(x);
 
