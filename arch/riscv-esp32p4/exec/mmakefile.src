
include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv-esp32p4/board/board.mk

CFILES          := \
        superstate cpu_init

ifeq ($(AROS_TARGET_VARIANT),smp)
CFILES += platform_init p4_signal_protocol p4_signal_adapter settaskpri \
          p4_softint_queue p4_softint cause exception setsignal setexcept \
          allocsignal freesignal p4_etask_gate p4_etask_identity \
          p4_etask_identity_binding p4_etask_lifetime \
          p4_cleanup_worker p4_task_cleanup wait p4_self_remove signal \
          p4_semaphore_gate p4_semaphore_cancel_worker p4_semaphore_public \
          p4_remove_bank p4_remove_completion p4_remove_wait p4_remove_external
endif

ifeq ($(P4_GIANT),1)
# Forbid()/Permit()/Disable()/Enable() take the Giant locks.
CFILES += forbid permit disable enable
endif

# P4_GIANT=1 selects the transitional Giant Exec SMP (kernel/p4_giant.h).
# The define must reach the generic rom/kernel, rom/exec and rom/task
# objects too, because their Exec macros come from exec_platform.h; the
# arch include-flag file is how arch settings reach those builds. mmake
# does not track it: rebuild kernel/exec/task cleanly when P4_GIANT changes.
P4_GIANT_ARCHFLAG := $(if $(filter 1,$(P4_GIANT)),-DP4_GIANT=1,) \
                     $(if $(filter 1,$(P4_GIANT_MIGRATE)),-DP4_GIANT_MIGRATE=1,)

%set_archincludes mainmmake=kernel-exec maindir=rom/exec \
  modname=exec pri=2 arch=esp32p4-riscv \
  includes="-I$(SRCDIR)/$(CURDIR) $(P4_GIANT_ARCHFLAG)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_EXEC_INCLUDES = \
    $(TARGET_EXEC_INCLUDES) \
    -I$(SRCDIR)/rom/exec \
    $(TARGET_KERNEL_INCLUDES) \
    -I$(SRCDIR)/rom/kernel

# The generic Exec include rule requests the architecture's kernel headers.
# This is a header-only dependency, not the Exec module build (which would
# recurse back through kernel-exec-includes).
#MM- kernel-exec-includes-esp32p4-riscv : kernel-kernel-includes

USER_INCLUDES   := $(PRIV_EXEC_INCLUDES)
USER_AFLAGS     := $(PRIV_EXEC_INCLUDES) -I$(GENINCDIR)
USER_CPPFLAGS   := $(P4_BOARD_CPPFLAGS)
ifeq ($(AROS_TARGET_VARIANT),smp)
USER_CPPFLAGS += -DP4_ATOMIC_CORE=1 -DP4_SIGNAL_TASK_PIN_BOUND=1
endif

%build_archspecific \
  mainmmake=kernel-exec maindir=rom/exec arch=esp32p4-riscv \
  files=$(CFILES) modname=exec

%common
