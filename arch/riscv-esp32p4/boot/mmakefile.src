#
#   The board-support package for the ESP32-P4 bring-up.
#
#   This is the standard AROS PKG v1 container, not a linked image.  Its
#   members are complete relocatable module files; the platform ELF loader
#   places and relocates them in PSRAM later.
#
#   A4 grows the package in measured steps.  These steps add the DOS side
#   without `dosboot.resource`: dos.library, the resources its initialisation
#   and LoadSeg path need, the shell pair a CLI needs, the FAT handler and
#   the emergency console.  All of those can be observed while the
#   post-krnStartExec() diagnostics still run, because nothing here takes
#   over COLDSTART.  `dosboot.resource` is what does, and it is added only
#   once these members are proven to load, relocate and initialise, so that
#   its arrival is the single variable in that step.
#
#   Note that `econsole` and `sdcard.device`'s `SDCard boot wait` resident
#   share priority -49.  That tie is harmless: one registers a boot node at
#   bootpri -127 and the other waits for pending bus tasks, neither depends
#   on the other, and dosboot at -50 follows both whichever way the link
#   order falls.  A resident that does depend on the order would have to say
#   so with a distinct priority rather than rely on this.
#

include $(SRCDIR)/config/aros.cfg

#MM kernel-package-esp32p4-riscv : \
#MM     kernel-utility \
#MM     kernel-expansion \
#MM     kernel-partition \
#MM     kernel-sdcard \
#MM     kernel-ramtest \
#MM     kernel-dos \
#MM     kernel-bootloader \
#MM     kernel-filesystem \
#MM     kernel-lddemon \
#MM     kernel-shell \
#MM     kernel-shellcommands \
#MM     kernel-fs-fat \
#MM     kernel-econsole

#MM kernel-package-esp32p4-riscv-quick : \
#MM     kernel-utility-quick \
#MM     kernel-expansion-quick \
#MM     kernel-partition-quick \
#MM     kernel-sdcard-quick \
#MM     kernel-ramtest-quick \
#MM     kernel-dos-quick \
#MM     kernel-bootloader-quick \
#MM     kernel-filesystem-quick \
#MM     kernel-lddemon-quick \
#MM     kernel-shell-quick \
#MM     kernel-shellcommands-quick \
#MM     kernel-fs-fat-quick \
#MM     kernel-econsole-quick

#
#   ramtest.device is the A2 corpus fixture.  It carries only const data and
#   has no write path, so including it costs a few kilobytes and no risk to
#   the medium.  Drop it from the package once A2 is verified.
#
PKG_LIBS      := utility partition dos
PKG_LIBS_ARCH := expansion
PKG_RES       := bootloader FileSystem lddemon shell shellcommands
PKG_DEVS      := sdcard ramtest
PKG_HANDLERS  := fat econsole

%make_package mmake=kernel-package-esp32p4-riscv \
    file=$(AROSARCHDIR)/aros-bsp.pkg \
    libs="$(PKG_LIBS)" arch_libs="$(PKG_LIBS_ARCH)" \
    res="$(PKG_RES)" devs="$(PKG_DEVS)" handlers="$(PKG_HANDLERS)"

%common
