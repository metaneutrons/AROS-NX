#
#   ramtest.device is the A2 corpus fixture.  It carries only const data and
#   has no write path, so including it costs a few kilobytes and no risk to
#   the medium.  Drop it from the package once A2 is verified.
#
PKG_LIBS      := aros utility oop graphics layers keymap intuition \
                 partition dos
PKG_LIBS_ARCH := expansion
PKG_HIDDS     := hiddclass gfx inputclass keyboard mouse fbgfx
PKG_RES       := bootloader FileSystem lddemon shell shellcommands dosboot
PKG_DEVS      := input keyboard gameport sdcard ramtest
PKG_HANDLERS  := fat econsole

# C3 adds the normal desktop's console, RAM: and utility support.  Keep these
# members behind the C3 selector so the accepted C2 package remains exactly
# reproducible rather than silently growing when its diagnostic is rebuilt.
ifeq ($(P4_C3_GRAPHICAL_BOOT),1)
PKG_LIBS      += gadtools
PKG_RES       += misc
PKG_DEVS      += console
PKG_HANDLERS  += con ram
endif

# The touch stack: the I2C bus classes and the ESP32-P4 bus driver, the
# generic touchscreen driver, the board's controller driver and
# esp32p4board.resource, which wires them together from the board profile.
# Opt-in like the rest of C4.
ifeq ($(P4_C4_TOUCH_HIDD),1)
PKG_HIDDS     += bus i2c i2c-esp32p4 touchscreen $(P4_BOARD_TOUCH_MODULE)
PKG_RES       += esp32p4board
endif

# C2's one-shot screen owner is an acceptance instrument, not a normal boot
# component.  Preserve it for exact C2 reproduction, but never put it in a C3
# (or unqualified) package where it would compete with Wanderer for the boot
# display.
ifeq ($(P4_C2_INTUITION_GATE),1)
PKG_RES       += c2screen
endif

#
#   The package shares its partition with the flash development volume, which
#   takes the last four megabytes; see P4_FLASHDISK_PART_OFFSET in
#   kernel/kernel_intern.h.  Growing past the split would have the loader
#   read filesystem bytes as package members, so it is a build error here
#   instead.
#
PKG_LIMIT := $(P4_BOARD_PKG_LIMIT)

%make_package mmake=kernel-package-esp32p4-riscv \
    file=$(AROSARCHDIR)/aros-bsp.pkg \
    libs="$(PKG_LIBS)" arch_libs="$(PKG_LIBS_ARCH)" \
    res="$(PKG_RES)" devs="$(PKG_DEVS)" handlers="$(PKG_HANDLERS)" \
    hidds="$(PKG_HIDDS)"

USER_LDFLAGS := -static

%build_module mmake=kernel-c2screen-esp32p4-riscv \
    modname=c2screen modtype=resource version=$(AROS_TARGET_PLATFORM) \
    files="c2screen"

#MM
kernel-package-esp32p4-riscv-checksize : kernel-package-esp32p4-riscv
	@size=`wc -c < $(AROSARCHDIR)/aros-bsp.pkg` ; \
	if $(TEST) $$size -gt $(PKG_LIMIT) ; then \
	    $(ECHO) "aros-bsp.pkg is $$size bytes, over the $(PKG_LIMIT)-byte" \
	            "split with the flash development volume" ; \
	    exit 1 ; \
	else \
	    $(ECHO) "Package     $$size of $(PKG_LIMIT) bytes before the flash volume" ; \
	fi

%common
