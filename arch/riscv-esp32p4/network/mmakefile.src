include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv-esp32p4/board/board.mk

# Use the BSP static link mode. The default link mode produced runtime frame
# registration references to .eh_frame, which the P4 loader does not place.
USER_LDFLAGS := -static

# Opt-in native identification/setup/INIT gate, not a working SANA-II device.
USER_CPPFLAGS := $(P4_BOARD_CPPFLAGS)
ifeq ($(P4_WIFI_SDIO_SETUP),1)
USER_CPPFLAGS += -DP4_WIFI_SDIO_SETUP=1
endif
ifeq ($(P4_WIFI_HOSTED_INIT),1)
USER_CPPFLAGS += -DP4_WIFI_HOSTED_INIT=1
endif
ifeq ($(P4_WIFI_HOSTED_REPLY),1)
USER_CPPFLAGS += -DP4_WIFI_HOSTED_REPLY=1
endif
ifeq ($(P4_WIFI_HOSTED_MAC),1)
USER_CPPFLAGS += -DP4_WIFI_HOSTED_MAC=1
endif
ifeq ($(P4_WIFI_HOSTED_SCAN),1)
USER_CPPFLAGS += -DP4_WIFI_HOSTED_SCAN=1
endif
ifeq ($(P4_WIFI_HOSTED_OWNER),1)
USER_CPPFLAGS += -DP4_WIFI_HOSTED_OWNER=1
P4_WIFI_OWNER_CPU ?= 1
USER_CPPFLAGS += -DP4_WIFI_OWNER_CPU=$(P4_WIFI_OWNER_CPU)
endif
ifeq ($(P4_WIFI_C6_PRIVACY_RECOVERY_VERIFIED),1)
USER_CPPFLAGS += -DP4_WIFI_C6_PRIVACY_RECOVERY_VERIFIED=1
endif
ifeq ($(P4_WIFI_HOST_PRIVACY_RECOVERY_VERIFIED),1)
USER_CPPFLAGS += -DP4_WIFI_HOST_PRIVACY_RECOVERY_VERIFIED=1
endif
ifeq ($(P4_WIFI_SDIO_RESET_QUERY),1)
USER_CPPFLAGS += -DP4_WIFI_SDIO_RESET_QUERY=1
endif
%build_module mmake=kernel-esp32p4wifi-probe \
    modname=esp32p4wifi modtype=resource version=$(AROS_TARGET_PLATFORM) \
    files="runtime_probe sdio_probe sdio_commands sdio_setup sdio_restore sdio_reset_query hosted_fifo hosted_wire hosted_init hosted_open hosted_config hosted_tx hosted_rpc hosted_serial hosted_mac hosted_epoch_reassembly hosted_request_ids hosted_inbox hosted_frames hosted_rx hosted_pending hosted_owner hosted_control hosted_wifi hosted_startup hosted_scan hosted_scan_sequence hosted_association hosted_link"
# Private resource bridge is defined by this port, not generated public ABI.
# Build separately; packaging remains an explicit qualification step.
%build_module mmake=kernel-esp32p4wlan-device \
    modname=esp32p4wlan modtype=device version=$(AROS_TARGET_PLATFORM) \
    files="sana_device" moduledir=Devs/Networks

%common
