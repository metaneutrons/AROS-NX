include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv-esp32p4/board/board.mk

# Opt-in native identification/setup, not a working Hosted/SANA-II device.
USER_CPPFLAGS := $(P4_BOARD_CPPFLAGS)
ifeq ($(P4_WIFI_SDIO_SETUP),1)
USER_CPPFLAGS += -DP4_WIFI_SDIO_SETUP=1
endif
%build_module mmake=kernel-esp32p4wifi-probe \
    modname=esp32p4wifi modtype=resource version=$(AROS_TARGET_PLATFORM) \
    files="runtime_probe sdio_probe sdio_commands sdio_setup sdio_restore"
%common
