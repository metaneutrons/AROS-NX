include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv-esp32p4/board/board.mk

# The ESP32-P4 platform on riscv-native: this directory holds what is
# particular to the SoC - start-up, trap entry, clocks, CLIC, SYSTIMER,
# PSRAM, flash, console and watchdog - and riscv-native the context switch,
# the trap dispatch, the SMP scheduler and the IPI core (kernel_native.c
# connects the two).
#
# The board profile reaches every kernel object through the arch include
# flags: kernel_intern.h includes board/board.h, which refuses to build
# without one. mmake does not track the flag file: rebuild the kernel
# cleanly when the board changes.
%set_archincludes mainmmake=kernel-kernel maindir=rom/kernel \
  modname=kernel pri=10 arch=esp32p4-riscv \
  includes="-I$(SRCDIR)/$(CURDIR) $(P4_BOARD_CPPFLAGS)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_KERNEL_INCLUDES = \
    $(TARGET_KERNEL_INCLUDES) \
	-I$(SRCDIR)/rom/kernel \
	$(TARGET_EXEC_INCLUDES) \
	-I$(SRCDIR)/rom/exec

ifneq ($(AROS_TARGET_VARIANT),smp)
$(error esp32p4 builds only the smp variant; configure this tree again)
endif

CFILES := \
        _displayalert \
        appdesc \
        cpuclock \
        flash_ab_layout \
        getsystemattr \
        kernel_cache \
        kernel_clic \
        kernel_console \
        kernel_consoletask \
        kernel_debug \
        kernel_elf \
        kernel_flash \
        kernel_native \
        kernel_quiesce \
        kernel_ram \
        kernel_smptest \
        kernel_startup \
        kernel_timer \
        kernel_wdt \
        kernel_wdtcanary \
        maygetchar \
        platform_init \
        psram_init \
        psram_tuning

AFILES := \
        startup \
        traps \
        secondary_smp

# P4_S4_TEST=1: the SMP acceptance test, a cold-start resident that runs
# bound task pairs on both harts (kernel_smptest.c).
ifdef P4_S4_TEST
P4_DEBUG_CPPFLAGS += -DP4_S4_TEST
endif
# P4_CPU_MHZ=360 raises the CPU clock from what the bootloader left.
ifdef P4_CPU_MHZ
P4_DEBUG_CPPFLAGS += -DP4_CPU_MHZ=$(P4_CPU_MHZ)
endif

USER_INCLUDES := $(PRIV_KERNEL_INCLUDES) -I$(GENINCDIR)
# startup.S, traps.S and secondary_smp.S read aros/config.h and the TLS
# offsets (riscv-native's tls.h)
USER_AFLAGS := $(PRIV_KERNEL_INCLUDES) -I$(GENINCDIR)
USER_CPPFLAGS := -D__AROS_EXEC_LIBRARY__ $(P4_BOARD_CPPFLAGS) $(P4_DEBUG_CPPFLAGS)

# With compiler=kernel, %build_archspecific compiles with KERNEL_CFLAGS,
# which are only USER_CFLAGS: without this line the port's kernel code is
# built unoptimized. Optimized loops must not turn into memset()/memcpy()
# calls: those live in XIP flash, and P4_SRAMCODE runs while flash or the
# cache is unavailable (check-sramtext.sh catches what slips through).
USER_CFLAGS += $(KERNEL_OPTIMIZATION_CFLAGS) -fno-tree-loop-distribute-patterns

%build_archspecific \
  mainmmake=kernel-kernel modname=kernel maindir=rom/kernel arch=esp32p4-riscv \
  files="$(CFILES)" asmfiles="$(AFILES)" compiler=kernel

#MM kernel-kernel-esp32p4-riscv : includes

# The platform invokes the native RISC-V code (riscv-native) from its own
# targets, as riscv64-sbi does.
#MM- kernel-kernel-esp32p4 : kernel-kernel-native-riscv
#MM- kernel-kernel-esp32p4-quick : kernel-kernel-native-riscv-quick
#MM- kernel-kernel-esp32p4-linklib : kernel-kernel-native-riscv-linklib
#MM- kernel-kernel-esp32p4-set-archincludes : kernel-kernel-native-riscv-set-archincludes

# The kickstart holds only what has to exist before anything can be
# loaded: kernel.resource, exec.library, task.resource and the timer.
# Everything else, utility.library included, belongs in a package the
# loader places in RAM later.
BSP_RES  := kernel task
BSP_LIBS := exec debug
BSP_DEVS := timer

BSP_KOBJS := \
    $(addprefix $(KOBJSDIR)/, $(addsuffix _resource.o, $(BSP_RES))) \
    $(addprefix $(KOBJSDIR)/, $(addsuffix _library.o, $(BSP_LIBS))) \
    $(addprefix $(KOBJSDIR)/, $(addsuffix _device.o, $(BSP_DEVS)))

# -lexec is what carries SysBase into the image, and -lamiga what
# satisfies libautoinit's error path.
ELFCORELIBS := -L$(AROS_LIB) -lexec -larossupport -lautoinit -llibinit \
               -lamiga -lstdc.static
ifeq ("$(AROS_TOOLCHAIN)","gnu")
ELFCORELIBS += -L$(CROSSTOOLSDIR)/lib/gcc/$(AROS_TARGET_CPU)-aros/$(TARGET_GCC_VER) -lgcc
endif

# The image declares the silicon it will run on: the pre-v3 revisions
# that go with the link script's memory windows. An image built for one
# family must not be loaded by a bootloader on the other.
ESP32P4_REV_MIN ?= $(P4_BOARD_REV_MIN)
ESP32P4_REV_MAX ?= $(P4_BOARD_REV_MAX)
ESPTOOL         ?= esptool

ELF2IMAGE = $(ESPTOOL) --chip esp32p4 elf2image --flash-mode dio \
	    --flash-freq 80m --flash-size $(P4_BOARD_FLASH_SIZE) \
	    --min-rev-full $(ESP32P4_REV_MIN) --max-rev-full $(ESP32P4_REV_MAX)

#MM kernel-esp32p4-riscv : kernel-kernel-kobj kernel-exec-kobj kernel-task-kobj \
#MM     kernel-debug-kobj kernel-timer-kobj
#MM
kernel-esp32p4-riscv: $(OSGENDIR)/boot/aros-esp32p4.bin
	$(Q)$(NOP)

# Code and read-only data stay in flash, mapped by the second stage
# bootloader through the cache (the kickstart does not fit the internal
# SRAM). What has to run while the cache is off is P4_SRAMCODE, which
# check-sramtext.sh holds to that.
P4_LDSCRIPT := ldscript-xip.lds

$(OSGENDIR)/boot/core.elf: $(BSP_KOBJS) $(SRCDIR)/$(CURDIR)/$(P4_LDSCRIPT) \
                          $(SRCDIR)/$(CURDIR)/check-sramtext.sh
	@$(ECHO) "Creating   $@ with $(P4_LDSCRIPT)"
	%mkdirs_q $(OSGENDIR)/boot
	@$(KERNEL_LD) -Map $(OSGENDIR)/boot/core.map \
	    -T $(SRCDIR)/$(CURDIR)/$(P4_LDSCRIPT) -o $@ $(filter %.o,$^) $(ELFCORELIBS)
	@$(ECHO) "Checking   $@ SRAM residency"
	@$(SHELL) $(SRCDIR)/$(CURDIR)/check-sramtext.sh "$(TARGET_OBJDUMP)" "$@"

# The ota_0 app partition at 0x20000, loaded and mapped by the second
# stage bootloader the device carries.
$(OSGENDIR)/boot/aros-esp32p4.bin: $(OSGENDIR)/boot/core.elf \
    $(SRCDIR)/arch/riscv-esp32p4/tools/check-artifact-size.py
	@$(ECHO) "Creating   $@"
	@$(ELF2IMAGE) -o $@ $<
	@$(PYTHON) $(SRCDIR)/arch/riscv-esp32p4/tools/check-artifact-size.py \
	    "$@" $(P4_BOARD_CORE_LIMIT)

%common
