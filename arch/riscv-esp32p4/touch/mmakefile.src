include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv-esp32p4/board/board.mk

#MM kernel-hidd-p4touch : kernel-hidd-mouse kernel-hidd-input linklibs

FILES := p4touch_init p4touch_mouseclass p4touch_worker p4touch_policy

P4_TOUCH_EDGE_TRACE ?= 0

USER_CPPFLAGS += \
    -DP4_TOUCH_EDGE_TRACE=$(P4_TOUCH_EDGE_TRACE) \
    $(P4_BOARD_CPPFLAGS) \
    -D__OOP_NOLIBBASE__ \
    -D__UTILITY_NOLIBBASE__ \
    -D__OOP_NOMETHODBASES__ \
    -D__OOP_NOATTRBASES__

USER_LDFLAGS := -static

%build_module mmake=kernel-hidd-p4touch \
    modname=p4touch modtype=hidd files=$(FILES)
