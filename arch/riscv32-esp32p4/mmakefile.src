# $Id$

include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/arch/riscv32-esp32p4/config/aros-esp32p4.cfg

BINDIR := $(GENDIR)/bin/esp32p4

.PHONY: esp32p4-image esp32p4-flash esp32p4-app-flash esp32p4-monitor

#MM- distfiles-riscv32-esp32p4 : distfiles-esp32p4-storage

#MM distfiles-esp32p4-storage : \
#MM     kernel-package-esp32p4 \
#MM     workbench-all \
#MM     workbench-devs-networks-esp32c6

# Generate 32MB merged flash image with Base Workbench
esp32p4-image:
	@mkdir -p $(BINDIR)
	@python3 arch/riscv32-esp32p4/flash/compile_partitions.py \
		arch/riscv32-esp32p4/flash/partitions.csv \
		$(BINDIR)/partitions.bin
	@python3 arch/riscv32-esp32p4/flash/create_workbench_disk.py \
		$(BINDIR)/workbench_flash.bin
	@python3 arch/riscv32-esp32p4/flash/merge_image.py \
		$(BINDIR)/aros-esp32p4-merged-32mb.bin \
		$(BINDIR)/bootloader.bin \
		$(BINDIR)/partitions.bin \
		$(BINDIR)/otadata.bin \
		$(BINDIR)/aros_a.bin \
		$(BINDIR)/workbench_flash.bin

# Generate Full 512MB MicroSD Workbench disk image
esp32p4-sdcard:
	@mkdir -p $(BINDIR)
	@python3 arch/riscv32-esp32p4/flash/create_sdcard_image.py \
		$(BINDIR)/aros_sd_workbench.img

# Flash full 32MB image
esp32p4-flash: esp32p4-image
	esptool.py --chip esp32p4 --port $(ESP32_PORT) --baud $(ESP32_BAUD) \
		write_flash 0x0 $(BINDIR)/aros-esp32p4-merged-32mb.bin

# Fast incremental flash of AROS kernel into Slot A (0x20000)
esp32p4-app-flash:
	esptool.py --chip esp32p4 --port $(ESP32_PORT) --baud $(ESP32_BAUD) \
		write_flash 0x20000 $(BINDIR)/aros_a.bin

# Monitor serial console
esp32p4-monitor:
	python3 -m serial.tools.miniterm $(ESP32_PORT) 115200 --raw
