
include $(SRCDIR)/config/aros.cfg

#MM hidd-fbgfx : kernel-hidd-gfx-includes

FILES	:=	\
	fbgfx_init \
	fbgfx_hiddclass \
	fbgfx_displayclass \
	fbgfx_support \
	fbgfx_bitmapclass

USER_LDFLAGS := -static

USER_CPPFLAGS := \
               -D__OOP_NOATTRBASES__

ifeq ($(P4_C1_FRAMEBUFFER_HIDD),1)
USER_CPPFLAGS += -DP4_C1_FRAMEBUFFER_HIDD -I$(GENINCDIR)
endif

ifeq ($(P4_C3_GRAPHICAL_BOOT),1)
USER_CPPFLAGS += -DP4_C1_FRAMEBUFFER_HIDD -DP4_C3_GRAPHICAL_BOOT -I$(GENINCDIR)
endif

ifeq ($(P4_C2_INTUITION_GATE),1)
USER_CPPFLAGS += -DP4_C2_INTUITION_GATE
endif

%build_module mmake=hidd-fbgfx \
  modname=fbgfx modtype=hidd \
  files=$(FILES)
